export function getCityKey(city: City): string {
  return city.id ?? 'legacy:' + city.name + ':' + city.timezone
}

export function getOffsetHours(zoneId: string, timestamp: number): number {
  return offsetMillisecondsToHours(i18n.getTimeZone(zoneId).getOffset(timestamp))
}

export function offsetMillisecondsToHours(offsetMilliseconds: number): number {
  return offsetMilliseconds / 3600000
}
